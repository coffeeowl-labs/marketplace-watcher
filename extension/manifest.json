{
  "manifest_version": 3,
  "name": "Marketplace Watcher",
  "version": "0.1.0",
  "description": "Evaluate selected Facebook Marketplace listings via a local Claude helper.",

  "permissions": ["storage", "tabs", "nativeMessaging"],
  "host_permissions": [
    "*://www.facebook.com/marketplace/*",
    "*://*.fbcdn.net/*",
    "https://nominatim.openstreetmap.org/*",
    "https://router.project-osrm.org/*"
  ],

  "background": {
    "scripts": ["protocol.js", "native_messaging.js", "background.js"]
  },

  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },

  "content_scripts": [
    {
      "matches": ["*://www.facebook.com/marketplace/*search*"],
      "js": ["content/search.js"],
      "css": ["content/overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://www.facebook.com/marketplace/item/*"],
      "js": ["content/listing.js"],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "marketplace-watcher@coffeeowl-labs.github.io",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
